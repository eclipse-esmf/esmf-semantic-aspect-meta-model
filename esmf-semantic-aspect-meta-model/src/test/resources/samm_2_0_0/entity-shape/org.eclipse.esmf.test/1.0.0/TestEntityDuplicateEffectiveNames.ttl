@prefix : <urn:samm:org.eclipse.esmf.samm.test:1.0.0#> .
@prefix other: <urn:samm:org.eclipse.esmf.other:1.0.0#> .
@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.0.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.0.0#> .

:TestEntityDuplicateEffectiveNames a samm:Entity ;
   samm:properties ( :a [ samm:property :b ; samm:payloadName "a" ] ) .

:TestEntityDuplicateEffectiveNames1 a samm:Entity ;
   samm:properties ( [ samm:property :a ; samm:payloadName "same" ] [ samm:property :b ; samm:payloadName "same" ] ) .

:TestEntityDuplicateEffectiveNames2 a samm:Entity ;
   samm:properties ( :a :a ) .

:TestEntityDuplicateEffectiveNames3 a samm:Entity ;
   samm:properties ( :a other:a ) .

:TestEntityDuplicateEffectiveNames4 a samm:Entity ;
   samm:properties ( [ samm:property :a ; samm:optional true ] :a ) .

:a a samm:Property ;
   samm:characteristic samm-c:Text .

:b a samm:Property ;
   samm:characteristic samm-c:Text .

:c a samm:Property ;
   samm:characteristic samm-c:Text .

other:a a samm:Property ;
   samm:characteristic samm-c:Text .

